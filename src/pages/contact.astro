---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config';
---

<BaseLayout title="Contact" description={`Contact ${siteConfig.legalName} by email or Instagram.`}>
  <header class="page-header page-shell">
    <p class="eyebrow">Contact / Studio inquiries</p>
    <h1 id="contact-title">Start a<br />conversation.</h1>
  </header>

  <section class="contact page-shell" aria-labelledby="contact-title">
    <div class="contact-options">
      <p>For artwork, commission, or studio inquiries, contact the artist directly using one of the links below.</p>
      <a href={`mailto:${siteConfig.email}`}>
        <span>Email</span>
        <strong>{siteConfig.email}</strong>
        <span aria-hidden="true">↗</span>
      </a>
      <a href={siteConfig.instagram} rel="me">
        <span>Instagram</span>
        <strong>{siteConfig.instagramHandle}</strong>
        <span aria-hidden="true">↗</span>
      </a>
      <p class="legal-name">{siteConfig.legalName}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    padding-block: clamp(3rem, 6vw, 6rem) clamp(5rem, 10vw, 10rem);
  }

  .contact-options {
    max-width: 44rem;
    margin-inline: auto;
  }

  .contact-options > p:first-child {
    max-width: 34rem;
    margin: 0 auto 2rem;
    color: var(--paper-muted);
    text-align: center;
  }

  .contact-options > a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.25rem 1rem;
    align-items: center;
    min-height: 5rem;
    padding-block: 0.75rem;
    text-decoration: none;
    border-top: 1px solid var(--line);
  }

  .contact-options > a:last-of-type {
    border-bottom: 1px solid var(--line);
  }

  .contact-options > a > span {
    color: var(--paper-muted);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .contact-options strong {
    grid-column: 1;
    font-family: var(--serif);
    font-size: clamp(1.3rem, 2vw, 2rem);
    font-weight: 400;
    overflow-wrap: anywhere;
  }

  .contact-options > a > span:last-child {
    grid-column: 2;
    grid-row: 1 / span 2;
  }

  .legal-name {
    margin: 1.25rem 0 0;
    text-align: center;
    color: var(--paper-muted);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
</style>
