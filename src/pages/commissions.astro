---
import { getCollection } from 'astro:content';
import ArtworkImage from '../components/ArtworkImage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const artworks = (await getCollection('artworks')).sort((a, b) =>
  a.data.sortOrder - b.data.sortOrder || a.data.title.localeCompare(b.data.title)
);
const artwork = artworks.find((item) => item.data.commission)
  ?? artworks.find((item) => item.data.featured)
  ?? artworks[0];
const detail = artwork.data.images.find((image) => image.type === 'detail') ?? artwork.data.hero;

const steps = [
  {
    title: 'Start with an idea',
    copy: 'Share a meaningful object, subject, memory, material, color, or general concept.',
  },
  {
    title: 'Establish the direction',
    copy: 'Artist and client discuss the broad direction, approximate size, meaningful elements, practical constraints, and other relevant considerations.',
  },
  {
    title: 'Artist interpretation',
    copy: 'The artist determines much of the composition, materials, texture, and visual treatment.',
  },
  {
    title: 'Creation',
    copy: "The work develops through experimentation and the artist's process. Changes and discoveries are part of making the piece.",
  },
  {
    title: 'Finished work',
    copy: 'The client receives a unique Endeavor piece influenced by the original idea rather than dictated by a fixed design.',
  },
];
---

<BaseLayout title="Commissions" description="How artist-led commissions work at Endeavor Art Studio.">
  <header class="commission-header page-shell">
    <p class="eyebrow">Commissions / Artist-led work</p>
    <h1>An idea,<br />interpreted.</h1>
    <div>
      <span class="draft-note">All commission copy requires artist review</span>
      <p>Commissions begin with a direction rather than an exact design. The artist uses your starting point to create an original work through her own material practice.</p>
    </div>
  </header>

  <div class="commission-image">
    <ArtworkImage
      src={detail.src}
      alt={detail.alt}
      caption={`Material detail${artwork.data.placeholder ? ' · Sample image' : ''}`}
      sizes="100vw"
      loading="eager"
      lightbox
      gallery="commission-detail"
    />
  </div>

  <section class="process section page-shell" aria-labelledby="process-title">
    <h2 id="process-title" class="section-label">The process</h2>
    <ol>
      {steps.map((step, index) => (
        <li>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h3>{step.title}</h3>
          <p>{step.copy}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="expectation page-shell" aria-labelledby="expectation-title">
    <div>
      <p class="section-label">What to expect</p>
      <h2 id="expectation-title">Original work, not exact reproduction.</h2>
    </div>
    <div>
      <span class="draft-note">Draft for artist review</span>
      <blockquote>
        <p>“Each commission is an original Endeavor work. Because experimentation is part of the process, final compositions are not predetermined or reproduced from exact references.”</p>
      </blockquote>
      <p>Before accepting a project, the artist will confirm whether its subject, timing, scale, and practical requirements suit her practice. Acceptance is not automatic.</p>
    </div>
  </section>

  <section class="commission-contact page-shell" aria-labelledby="contact-title">
    <p class="eyebrow">Have a starting point?</p>
    <h2 id="contact-title">Describe the idea and why it matters to you.</h2>
    <a class="text-link" href="/contact">Contact the studio</a>
  </section>
</BaseLayout>

<style>
  .commission-header {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2rem;
    padding-block: clamp(5rem, 11vw, 11rem);
  }

  .commission-header h1 {
    grid-column: 2;
    margin: 0;
  }

  .commission-header > div {
    grid-column: 2;
    max-width: 40rem;
    margin: 2rem 0 0 auto;
    color: var(--paper-muted);
  }

  .commission-image {
    max-height: 78svh;
    overflow: hidden;
  }

  .commission-image :global(img) {
    width: 100%;
    min-height: 60svh;
    max-height: 78svh;
    object-fit: cover;
  }

  .process ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .process li {
    display: grid;
    grid-template-columns: 0.35fr 1fr 1fr;
    gap: 2rem;
    align-items: baseline;
    padding-block: clamp(1.75rem, 4vw, 3.5rem);
    border-bottom: 1px solid var(--line);
  }

  .process li > span {
    color: var(--clay);
    font-family: var(--serif);
    font-size: 1.5rem;
  }

  .process h3 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 4rem);
  }

  .process li p {
    margin: 0;
    color: var(--paper-muted);
  }

  .expectation {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(3rem, 9vw, 11rem);
    padding-block: var(--section-space);
    background: var(--charcoal);
    box-shadow: 0 0 0 100vmax var(--charcoal);
    clip-path: inset(0 -100vmax);
  }

  .expectation h2 {
    font-size: clamp(3rem, 6vw, 6rem);
  }

  blockquote {
    margin: 0 0 2rem;
    font-family: var(--serif);
    font-size: clamp(1.8rem, 3vw, 3.2rem);
    line-height: 1.15;
  }

  .expectation > div:last-child > p:last-child {
    color: var(--paper-muted);
  }

  .commission-contact {
    padding-block: var(--section-space);
    text-align: center;
  }

  .commission-contact h2 {
    max-width: 68rem;
    margin: 2rem auto 3rem;
  }

  @media (max-width: 47.99rem) {
    .commission-header,
    .expectation {
      grid-template-columns: 1fr;
    }

    .commission-header h1,
    .commission-header > div {
      grid-column: 1;
    }

    .commission-header > div {
      margin-left: 0;
    }

    .process li {
      grid-template-columns: 3rem 1fr;
      gap: 0.5rem 1rem;
    }

    .process li p {
      grid-column: 2;
    }
  }
</style>
