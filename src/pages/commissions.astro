---
import ArtworkImage from '../components/ArtworkImage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSortedArtworks, inSection } from '../lib/artworks';
import { sectionPath } from '../sections';

const artworks = await getSortedArtworks();
const commissionArtworks = inSection(artworks, 'commissions');
const slides = (commissionArtworks.length > 0 ? commissionArtworks : artworks.slice(0, 1)).map((item) => ({
  src: item.data.hero.src,
  alt: item.data.hero.alt,
  caption: `${item.data.title}, ${item.data.year}`,
}));

const steps = [
  {
    title: 'Start with an idea',
    copy: 'Share a meaningful object, subject, memory, material, color, or general concept.',
  },
  {
    title: 'Establish the direction',
    copy: 'Artist and client discuss the broad direction, approximate size, meaningful elements, practical constraints, and other relevant considerations.',
  },
  {
    title: 'Artist interpretation',
    copy: 'The artist determines much of the composition, materials, texture, and visual treatment.',
  },
  {
    title: 'Creation',
    copy: "The work develops through experimentation and the artist's process. Changes and discoveries are part of making the piece.",
  },
  {
    title: 'Finished work',
    copy: 'The client receives a unique Endeavor piece influenced by the original idea rather than dictated by a fixed design.',
  },
];
---

<BaseLayout title="Commissions" description="How artist-led commissions work at Endeavor Art Studio.">
  <header class="commission-header page-shell">
    <p class="eyebrow">Commissions / Artist-led work</p>
    <h1>An idea,<br />interpreted.</h1>
    <div>
      <span class="draft-note">All commission copy requires artist review</span>
      <p>Commissions begin with a direction rather than an exact design. The artist uses your starting point to create an original work through her own material practice.</p>
    </div>
  </header>

  <div class="commission-image" data-commission-rotator>
    {slides.map((slide, index) => (
      <div class:list={['commission-slide', { 'is-active': index === 0 }]} data-commission-slide inert={index !== 0}>
        <ArtworkImage
          src={slide.src}
          alt={slide.alt}
          caption={slide.caption}
          sizes="100vw"
          loading={index === 0 ? 'eager' : 'lazy'}
          lightbox
          gallery="commission-hero"
        />
      </div>
    ))}
    {slides.length > 1 && (
      <p class="slide-label" data-commission-label aria-hidden="true">{slides[0].caption}</p>
    )}
  </div>

  <script>
    const rotator = document.querySelector<HTMLElement>('[data-commission-rotator]');
    const label = document.querySelector<HTMLElement>('[data-commission-label]');

    if (rotator && label) {
      const slides = Array.from(rotator.querySelectorAll<HTMLElement>('[data-commission-slide]'));

      if (slides.length > 1) {
        const captions = slides.map(
          (slide) => slide.querySelector<HTMLElement>('[data-lightbox-caption]')?.dataset.lightboxCaption ?? '',
        );
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        let index = 0;
        let timer: number | undefined;

        const show = (next: number) => {
          index = (next + slides.length) % slides.length;
          slides.forEach((slide, slideIndex) => {
            slide.classList.toggle('is-active', slideIndex === index);
            slide.inert = slideIndex !== index;
          });
          label.textContent = captions[index];
        };

        const stop = () => {
          if (timer === undefined) return;
          window.clearInterval(timer);
          timer = undefined;
        };

        const start = () => {
          stop();
          if (reducedMotion.matches || document.hidden) return;
          timer = window.setInterval(() => show(index + 1), 5000);
        };

        rotator.addEventListener('pointerenter', stop);
        rotator.addEventListener('pointerleave', start);
        rotator.addEventListener('focusin', stop);
        rotator.addEventListener('focusout', start);
        document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
        reducedMotion.addEventListener('change', () => (reducedMotion.matches ? stop() : start()));
        start();
      }
    }
  </script>

  <section class="process section page-shell" aria-labelledby="process-title">
    <h2 id="process-title" class="section-label">The process</h2>
    <ol>
      {steps.map((step, index) => (
        <li>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h3>{step.title}</h3>
          <p>{step.copy}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="expectation page-shell" aria-labelledby="expectation-title">
    <div>
      <p class="section-label">What to expect</p>
      <h2 id="expectation-title">Original work, not exact reproduction.</h2>
    </div>
    <div>
      <span class="draft-note">Draft for artist review</span>
      <blockquote>
        <p>“Each commission is an original Endeavor work. Because experimentation is part of the process, final compositions are not predetermined or reproduced from exact references.”</p>
      </blockquote>
      <p>Before accepting a project, the artist will confirm whether its subject, timing, scale, and practical requirements suit her practice. Acceptance is not automatic.</p>
    </div>
  </section>

  <section class="commission-contact page-shell" aria-labelledby="contact-title">
    <p class="eyebrow">Have a starting point?</p>
    <h2 id="contact-title">Describe the idea and why it matters to you.</h2>
    <div class="contact-links">
      <a class="text-link" href="/contact">Contact the studio</a>
      {commissionArtworks.length > 0 && (
        <a class="text-link" href={sectionPath('commissions')}>See commissioned work</a>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .commission-header {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2rem;
    padding-block: clamp(5rem, 11vw, 11rem);
  }

  .commission-header h1 {
    grid-column: 2;
    margin: 0;
  }

  .commission-header > div {
    grid-column: 2;
    max-width: 40rem;
    margin: 2rem 0 0 auto;
    color: var(--paper-muted);
  }

  .commission-image {
    position: relative;
    height: min(78svh, 56rem);
    overflow: hidden;
  }

  .commission-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 900ms ease;
  }

  .commission-slide.is-active {
    opacity: 1;
  }

  .commission-slide :global(.image-button) {
    height: 100%;
  }

  .commission-slide :global(picture) {
    display: block;
    height: 100%;
  }

  .commission-slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .slide-label {
    position: absolute;
    z-index: 1;
    left: 0.75rem;
    bottom: 0.75rem;
    margin: 0;
    padding: 0.45rem 0.6rem;
    color: var(--paper-muted);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: rgb(11 11 10 / 78%);
  }

  .process ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .process li {
    display: grid;
    grid-template-columns: 0.35fr 1fr 1fr;
    gap: 2rem;
    align-items: center;
    padding-block: clamp(1.75rem, 4vw, 3.5rem);
    border-bottom: 1px solid var(--line);
  }

  .process li > span {
    color: var(--clay);
    font-family: var(--serif);
    font-size: 1.5rem;
  }

  .process h3 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 4rem);
  }

  .process li p {
    margin: 0;
    color: var(--paper-muted);
  }

  .expectation {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(3rem, 9vw, 11rem);
    padding-block: var(--section-space);
    background: var(--charcoal);
    box-shadow: 0 0 0 100vmax var(--charcoal);
    clip-path: inset(0 -100vmax);
  }

  .expectation h2 {
    font-size: clamp(3rem, 6vw, 6rem);
  }

  blockquote {
    margin: 0 0 2rem;
    font-family: var(--serif);
    font-size: clamp(1.8rem, 3vw, 3.2rem);
    line-height: 1.15;
  }

  .expectation > div:last-child > p:last-child {
    color: var(--paper-muted);
  }

  .commission-contact {
    padding-block: var(--section-space);
    text-align: center;
  }

  .commission-contact h2 {
    max-width: 68rem;
    margin: 2rem auto 3rem;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem clamp(1.5rem, 4vw, 4rem);
  }

  @media (max-width: 47.99rem) {
    .commission-header,
    .expectation {
      grid-template-columns: 1fr;
    }

    .commission-header h1,
    .commission-header > div {
      grid-column: 1;
    }

    .commission-header > div {
      margin-left: 0;
    }

    .process li {
      grid-template-columns: 3rem 1fr;
      gap: 0.5rem 1rem;
    }

    .process li p {
      grid-column: 2;
    }
  }
</style>
