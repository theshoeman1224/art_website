---
import { getCollection, type CollectionEntry } from 'astro:content';
import ArtworkImage from '../../components/ArtworkImage.astro';
import { siteConfig } from '../../config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { statusLabels } from '../../lib/artworks';

export async function getStaticPaths() {
  const artworks = await getCollection('artworks');
  return artworks.map((artwork) => ({
    params: { slug: artwork.data.slug },
    props: { artwork },
  }));
}

interface Props {
  artwork: CollectionEntry<'artworks'>;
}

const { artwork } = Astro.props;
const { data } = artwork;
// Without a description, the first secondary photograph takes its place beside the work details.
const besideDetails = data.description ? undefined : data.images[0];
const sequence = besideDetails ? data.images.slice(1) : data.images;
const metaDescription = data.description ?? `${data.title}, ${data.year}. ${data.dimensions}. Original work by ${siteConfig.title}.`;
---

<BaseLayout title={data.title} description={metaDescription}>
  <article>
    <header class="artwork-header page-shell">
      <a class="back-link" href="/artwork/">← All artwork</a>
      <div>
        <p class="eyebrow">{data.year}</p>
        <h1>{data.title}</h1>
      </div>
    </header>

    <div class="artwork-hero page-shell">
      <ArtworkImage
        src={data.hero.src}
        alt={data.hero.alt}
        fullResolution={data.fullResolution}
        caption={data.title}
        sizes="100vw"
        heightCap={{ vh: 88 }}
        priority
        lightbox
        gallery={data.slug}
      />
    </div>

    <section class="artwork-info section page-shell" aria-labelledby="work-details">
      <div>
        <h2 id="work-details" class="section-label">Work details</h2>
        <dl>
          <div><dt>Year</dt><dd>{data.year}</dd></div>
          <div><dt>Dimensions</dt><dd>{data.dimensions}</dd></div>
          {data.status && <div class="status"><dt>Status</dt><dd>{statusLabels[data.status]}</dd></div>}
        </dl>
        {!data.description && data.instagramUrl && (
          <a class="text-link" href={data.instagramUrl} rel="noreferrer">View on Instagram</a>
        )}
      </div>
      {data.description && (
        <div>
          <p class="large-copy">{data.description}</p>
          {data.instagramUrl && (
            <a class="text-link" href={data.instagramUrl} rel="noreferrer">View on Instagram</a>
          )}
        </div>
      )}
      {besideDetails && (
        <figure class="beside-details">
          <ArtworkImage
            src={besideDetails.src}
            alt={besideDetails.alt}
            fullResolution={data.fullResolution}
            caption={data.title}
            sizes="(min-width: 768px) 55vw, 100vw"
            lightbox
            gallery={data.slug}
          />
        </figure>
      )}
    </section>

    {sequence.length > 0 && (
      <section class="image-sequence page-shell" aria-labelledby="views-title">
        <h2 id="views-title" class="section-label">Surface and views</h2>
        {sequence.map((image, index) => (
          <figure class:list={[`image-${image.type}`, { first: index === 0 }]}>
            <ArtworkImage
              src={image.src}
              alt={image.alt}
              fullResolution={data.fullResolution}
              caption={data.title}
              sizes={index === 0 && image.type === 'detail' ? '100vw' : '(min-width: 768px) 65vw, 100vw'}
              lightbox
              gallery={data.slug}
            />
          </figure>
        ))}
      </section>
    )}

    <nav class="work-footer-nav page-shell" aria-label="Portfolio navigation">
      <a class="text-link" href="/artwork/">Back to all artwork</a>
      <a class="text-link" href={`/contact/?type=artwork&piece=${data.slug}`}>Ask about the work</a>
    </nav>
  </article>
</BaseLayout>

<style>
  .artwork-header {
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 2rem;
    align-items: end;
    padding-block: clamp(4rem, 9vw, 9rem) clamp(2rem, 5vw, 5rem);
  }

  .back-link {
    width: max-content;
    min-height: 2.75rem;
    color: var(--paper-muted);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .artwork-header h1 {
    margin: 0;
  }

  .artwork-hero {
    padding-inline: 0;
  }

  .artwork-hero :global(.image-button) {
    max-height: 88svh;
  }

  .artwork-hero :global(img) {
    width: 100%;
    max-height: 88svh;
    object-fit: contain;
  }

  .artwork-info {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: clamp(3rem, 10vw, 12rem);
  }

  dl {
    margin: 0;
    border-top: 1px solid var(--line);
  }

  dl div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--line);
  }

  dt {
    color: var(--paper-muted);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
  }

  .status {
    color: var(--paper-muted);
  }

  .artwork-info .large-copy {
    font-size: clamp(2rem, 3.5vw, 4rem);
  }

  .artwork-info dl + .text-link {
    margin-top: 2rem;
  }

  .beside-details {
    margin: 0;
  }

  .image-sequence {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(4rem, 9vw, 10rem) var(--page-pad);
    padding-bottom: var(--section-space);
  }

  .image-sequence > .section-label {
    grid-column: 1 / -1;
    margin-bottom: 0;
  }

  .image-sequence figure {
    grid-column: 2 / span 7;
    margin: 0;
  }

  .image-sequence figure:nth-of-type(even) {
    grid-column: 6 / -1;
  }

  .image-sequence .image-detail.first {
    grid-column: 1 / -1;
  }

  .work-footer-nav {
    display: flex;
    justify-content: space-between;
    padding-block: 2rem var(--section-space);
    border-top: 1px solid var(--line);
  }

  @media (max-width: 47.99rem) {
    .artwork-header,
    .artwork-info {
      grid-template-columns: 1fr;
    }

    .artwork-header {
      gap: 1rem;
    }

    .image-sequence {
      display: block;
    }

    .image-sequence figure {
      width: calc(100% + var(--page-pad));
      margin: 0 0 5rem;
    }

    .image-sequence figure:nth-of-type(even) {
      width: 88%;
      margin-left: auto;
    }

    .image-sequence .image-detail.first {
      width: calc(100% + var(--page-pad) * 2);
      margin-left: calc(var(--page-pad) * -1);
    }

    .work-footer-nav {
      display: grid;
      gap: 1rem;
    }
  }
</style>
