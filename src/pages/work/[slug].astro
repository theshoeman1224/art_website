---
import { getCollection, type CollectionEntry } from 'astro:content';
import ArtworkImage from '../../components/ArtworkImage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const artworks = await getCollection('artworks');
  return artworks.map((artwork) => ({
    params: { slug: artwork.data.slug },
    props: { artwork },
  }));
}

interface Props {
  artwork: CollectionEntry<'artworks'>;
}

const { artwork } = Astro.props;
const { data } = artwork;
const statusLabels = {
  artist_collection: 'Artist collection',
  private_collection: 'Private collection',
  commission: 'Commission',
  available: 'Available',
  not_for_sale: 'Not for sale',
};
---

<BaseLayout title={data.title} description={data.description}>
  {data.placeholder && (
    <aside class="record-notice page-shell">
      <strong>Sample artwork record</strong>
      <span>All artwork information and images on this page are placeholders for layout review.</span>
    </aside>
  )}

  <article>
    <header class="artwork-header page-shell">
      <a class="back-link" href="/work">← All work</a>
      <div>
        <p class="eyebrow">{data.year} / {data.medium}</p>
        <h1>{data.title}</h1>
      </div>
    </header>

    <div class="artwork-hero page-shell">
      <ArtworkImage
        src={data.hero.src}
        alt={data.hero.alt}
        caption={`${data.title} · Full view${data.placeholder ? ' · Sample image' : ''}`}
        sizes="100vw"
        loading="eager"
        lightbox
        gallery={data.slug}
      />
    </div>

    <section class="artwork-info section page-shell" aria-labelledby="work-details">
      <div>
        <h2 id="work-details" class="section-label">Work details</h2>
        <dl>
          <div><dt>Year</dt><dd>{data.year}</dd></div>
          <div><dt>Medium</dt><dd>{data.medium}</dd></div>
          <div><dt>Materials</dt><dd>{data.materials.join(', ')}</dd></div>
          <div><dt>Dimensions</dt><dd>{data.dimensions}</dd></div>
          {data.status && <div class="status"><dt>Status</dt><dd>{statusLabels[data.status]}</dd></div>}
        </dl>
      </div>
      <div>
        {data.placeholder && <span class="draft-note">Placeholder description</span>}
        <p class="large-copy">{data.description}</p>
        {data.instagramUrl && (
          <a class="text-link" href={data.instagramUrl} rel="noreferrer">View on Instagram</a>
        )}
      </div>
    </section>

    {data.images.length > 0 && (
      <section class="image-sequence page-shell" aria-labelledby="views-title">
        <h2 id="views-title" class="section-label">Surface and views</h2>
        {data.images.map((image, index) => (
          <figure class:list={[`image-${image.type}`, { first: index === 0 }]}>
            <ArtworkImage
              src={image.src}
              alt={image.alt}
              caption={`${data.title} · ${image.type} view${data.placeholder ? ' · Sample image' : ''}`}
              sizes={index === 0 ? '100vw' : '(min-width: 768px) 65vw, 100vw'}
              lightbox
              gallery={data.slug}
            />
            <figcaption>{image.type} view</figcaption>
          </figure>
        ))}
      </section>
    )}

    <nav class="work-footer-nav page-shell" aria-label="Portfolio navigation">
      <a class="text-link" href="/work">Return to all work</a>
      <a class="text-link" href="/contact">Ask about the work</a>
    </nav>
  </article>
</BaseLayout>

<style>
  .record-notice {
    display: flex;
    gap: 1rem;
    padding-block: 0.8rem;
    color: var(--paper-muted);
    font-size: 0.72rem;
    border-bottom: 1px solid var(--line);
  }

  .record-notice strong {
    color: var(--clay);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .artwork-header {
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 2rem;
    align-items: end;
    padding-block: clamp(4rem, 9vw, 9rem) clamp(2rem, 5vw, 5rem);
  }

  .back-link {
    width: max-content;
    min-height: 2.75rem;
    color: var(--paper-muted);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .artwork-header h1 {
    margin: 0;
  }

  .artwork-hero {
    padding-inline: 0;
  }

  .artwork-hero :global(.image-button) {
    max-height: 88svh;
  }

  .artwork-hero :global(img) {
    width: 100%;
    max-height: 88svh;
    object-fit: contain;
  }

  .artwork-info {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: clamp(3rem, 10vw, 12rem);
  }

  dl {
    margin: 0;
    border-top: 1px solid var(--line);
  }

  dl div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--line);
  }

  dt {
    color: var(--paper-muted);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
  }

  .status {
    color: var(--paper-muted);
  }

  .artwork-info .large-copy {
    font-size: clamp(2rem, 3.5vw, 4rem);
  }

  .image-sequence {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(4rem, 9vw, 10rem) var(--page-pad);
    padding-bottom: var(--section-space);
  }

  .image-sequence > .section-label {
    grid-column: 1 / -1;
    margin-bottom: 0;
  }

  .image-sequence figure {
    grid-column: 2 / span 7;
    margin: 0;
  }

  .image-sequence figure:nth-of-type(even) {
    grid-column: 6 / -1;
  }

  .image-sequence .image-detail.first {
    grid-column: 1 / -1;
  }

  .image-sequence figcaption {
    padding-top: 0.5rem;
    color: var(--paper-muted);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .work-footer-nav {
    display: flex;
    justify-content: space-between;
    padding-block: 2rem var(--section-space);
    border-top: 1px solid var(--line);
  }

  @media (max-width: 47.99rem) {
    .record-notice {
      display: block;
    }

    .record-notice strong {
      display: block;
    }

    .artwork-header,
    .artwork-info {
      grid-template-columns: 1fr;
    }

    .artwork-header {
      gap: 1rem;
    }

    .image-sequence {
      display: block;
    }

    .image-sequence figure {
      width: calc(100% + var(--page-pad));
      margin: 0 0 5rem;
    }

    .image-sequence figure:nth-of-type(even) {
      width: 88%;
      margin-left: auto;
    }

    .image-sequence .image-detail.first {
      width: calc(100% + var(--page-pad) * 2);
      margin-left: calc(var(--page-pad) * -1);
    }

    .image-sequence .image-detail.first figcaption {
      padding-left: var(--page-pad);
    }

    .work-footer-nav {
      display: grid;
      gap: 1rem;
    }
  }
</style>
