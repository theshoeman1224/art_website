---
import ArtworkImage from '../../components/ArtworkImage.astro';
import SectionNav from '../../components/SectionNav.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSortedArtworks, inSection } from '../../lib/artworks';
import { sectionPath, sections } from '../../sections';

const artworks = await getSortedArtworks();

// A work can sit in several sections, so skip leads an earlier tile already shows.
const usedLeads = new Set<string>();
const tiles = sections.map((section) => {
  const works = inSection(artworks, section.id);
  const lead = works.find((work) => !usedLeads.has(work.id)) ?? works[0];
  if (lead) usedLeads.add(lead.id);
  return { section, lead, count: works.length };
});
---

<BaseLayout title="Work" description="The complete artwork portfolio of Endeavor Art Studio.">
  <header class="work-header page-shell">
    <p class="eyebrow">Portfolio / {artworks.length} works</p>
    <h1>Work</h1>
    <p>Mixed-media assemblage, textured surfaces, and material studies. Each work retains the proportions in which it was photographed.</p>
  </header>

  <SectionNav />

  <section class="section-tiles page-shell" aria-label="Portfolio sections">
    <span class="draft-note">Section descriptions are a draft for artist review</span>
    <div class="artwork-grid">
      {tiles.map(({ section, lead, count }) => (
        <article class="section-tile">
          {lead && (
            <a class="tile-image artwork-frame" href={sectionPath(section.id)} aria-label={`View ${section.label}`}>
              <ArtworkImage
                src={lead.data.hero.src}
                alt={lead.data.hero.alt}
                sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
              />
            </a>
          )}
          <div class="tile-caption">
            <h2><a href={sectionPath(section.id)}>{section.label}</a></h2>
            <p class="eyebrow">{count} {count === 1 ? 'work' : 'works'}</p>
            <p>{section.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .work-header {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2rem;
    align-items: end;
    padding-block: clamp(5rem, 10vw, 10rem) clamp(3rem, 6vw, 6rem);
  }

  .work-header .eyebrow {
    align-self: start;
  }

  .work-header h1 {
    grid-column: 2;
    margin: 0;
  }

  .work-header > p:last-child {
    grid-column: 2;
    max-width: 35rem;
    margin: 1rem 0 0;
    color: var(--paper-muted);
  }

  .tile-image {
    display: block;
    overflow: hidden;
  }

  .tile-image :global(img) {
    width: 100%;
    transition: transform 500ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .tile-image:hover :global(img) {
    transform: scale(1.012);
  }

  .tile-caption {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .tile-caption h2 {
    margin-bottom: 0.5rem;
    font-size: clamp(2.4rem, 4vw, 4rem);
  }

  .tile-caption h2 a {
    text-decoration: none;
  }

  .tile-caption .eyebrow {
    margin-bottom: 0.75rem;
  }

  .tile-caption p:last-child {
    max-width: 26rem;
    margin: 0;
    color: var(--paper-muted);
  }

  @media (max-width: 47.99rem) {
    .work-header {
      grid-template-columns: 1fr;
    }

    .work-header h1,
    .work-header > p:last-child {
      grid-column: 1;
    }
  }
</style>
