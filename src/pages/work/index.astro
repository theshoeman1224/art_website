---
import { getCollection } from 'astro:content';
import ArtworkCard from '../../components/ArtworkCard.astro';
import PlaceholderNotice from '../../components/PlaceholderNotice.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const artworks = (await getCollection('artworks')).sort((a, b) =>
  a.data.sortOrder - b.data.sortOrder || a.data.title.localeCompare(b.data.title)
);
const hasPlaceholderArtwork = artworks.some((artwork) => artwork.data.placeholder);
---

<BaseLayout title="Work" description="The complete artwork portfolio of Endeavor Art Studio.">
  {hasPlaceholderArtwork && <PlaceholderNotice />}
  <header class="work-header page-shell">
    <p class="eyebrow">Portfolio / {artworks.length} works</p>
    <h1>Work</h1>
    <p>Mixed-media assemblage, textured surfaces, and material studies. Each work retains the proportions in which it was photographed.</p>
  </header>

  <section class="portfolio page-shell" aria-label="Artwork portfolio">
    {artworks.map((artwork) => (
      <ArtworkCard artwork={artwork} sizes="(min-width: 900px) 58vw, (min-width: 600px) 50vw, 100vw" />
    ))}
  </section>

  <aside class="future-note page-shell">
    <p class="eyebrow">Collection structure</p>
    <p>Future bodies of work or material categories can be introduced here without changing individual artwork records.</p>
  </aside>
</BaseLayout>

<style>
  .work-header {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2rem;
    align-items: end;
    padding-block: clamp(5rem, 10vw, 10rem);
  }

  .work-header .eyebrow {
    align-self: start;
  }

  .work-header h1 {
    grid-column: 2;
    margin: 0;
  }

  .work-header > p:last-child {
    grid-column: 2;
    max-width: 35rem;
    margin: 1rem 0 0;
    color: var(--paper-muted);
  }

  .portfolio {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(5rem, 10vw, 11rem) clamp(1rem, 3vw, 3rem);
    padding-bottom: var(--section-space);
  }

  .portfolio > :global(:nth-child(6n + 1)) { grid-column: 1 / span 7; }
  .portfolio > :global(:nth-child(6n + 2)) { grid-column: 9 / -1; margin-top: 13vw; }
  .portfolio > :global(:nth-child(6n + 3)) { grid-column: 2 / span 4; }
  .portfolio > :global(:nth-child(6n + 4)) { grid-column: 7 / -1; }
  .portfolio > :global(:nth-child(6n + 5)) { grid-column: 1 / span 5; margin-top: 7vw; }
  .portfolio > :global(:nth-child(6n + 6)) { grid-column: 7 / span 4; }

  .future-note {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2rem;
    padding-block: 2rem var(--section-space);
    color: var(--paper-muted);
    border-top: 1px solid var(--line);
  }

  .future-note p:last-child {
    max-width: 40rem;
  }

  @media (max-width: 47.99rem) {
    .work-header,
    .future-note {
      grid-template-columns: 1fr;
    }

    .work-header h1,
    .work-header > p:last-child {
      grid-column: 1;
    }

    .portfolio {
      display: block;
    }

    .portfolio > :global(*) {
      margin: 0 0 5rem !important;
    }

    .portfolio > :global(:nth-child(3n + 2)) {
      width: 84%;
      margin-left: auto !important;
    }
  }
</style>
