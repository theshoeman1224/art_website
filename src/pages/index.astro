---
import artistPortrait from '../assets/artist-portrait.jpg';
import ArtworkCard from '../components/ArtworkCard.astro';
import ArtworkImage from '../components/ArtworkImage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSortedArtworks } from '../lib/artworks';

const artworks = await getSortedArtworks();
const selectedArtworks = artworks.filter((artwork) => !artwork.data.placeholder).slice(0, 6);
const featuredArtworks = artworks.filter((artwork) => artwork.data.featured);
const hero = featuredArtworks[0] ?? artworks[0];
const feature = featuredArtworks.find((artwork) => artwork.id !== hero.id && artwork.data.images.some((image) => image.type === 'detail') && artwork.data.images.some((image) => image.type === 'angled')) ?? featuredArtworks[1] ?? hero;
const textureArtwork = featuredArtworks.find((artwork) => artwork.data.images.some((image) => image.type === 'detail')) ?? hero;
const textureImage = textureArtwork.data.images.find((image) => image.type === 'detail');
const featureDetail = feature.data.images.find((image) => image.type === 'detail');
const featureAngle = feature.data.images.find((image) => image.type === 'angled');
---

<BaseLayout>
  <section class="home-hero page-shell">
    <div class="hero-title">
      <h1><span>Endeavor</span><span>Art Studio</span></h1>
      <p>Mixed-media art exploring texture, material, and transformation.</p>
      <p class="hero-origin">
        <span class="draft-note">Draft for artist review</span>
        The studio shares its name with my first piece, <a href="/artwork/endeavor/">Endeavor</a>.
      </p>
    </div>
    <div class="hero-image">
      <ArtworkImage
        src={hero.data.hero.src}
        alt={hero.data.hero.alt}
        fullResolution={hero.data.fullResolution}
        caption={`${hero.data.title}, ${hero.data.year}`}
        sizes="(min-width: 768px) 58vw, 100vw"
        heightCap={{ vh: 72, slot: 58, media: '(min-width: 768px)' }}
        priority
        lightbox
        gallery="home-hero"
      />
      <p><span>{hero.data.title}</span><span>{hero.data.year}</span></p>
    </div>
  </section>

  <section class="selected section page-shell" aria-labelledby="selected-title">
    <h2 id="selected-title" class="section-label">Selected work</h2>
    <div class="selected-grid artwork-grid artwork-grid--fill">
      {selectedArtworks.map((artwork) => (
        <ArtworkCard artwork={artwork} headingLevel="h3" sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" />
      ))}
    </div>
    <div class="section-action"><a class="text-link" href="/artwork/">View all artwork</a></div>
  </section>

  <section class="practice section page-shell" aria-labelledby="practice-title">
    <div>
      <h2 id="practice-title" class="section-label">Artistic practice</h2>
      <span class="draft-note">Draft for artist review</span>
    </div>
    <div class="practice-copy">
      <p class="large-copy">Familiar materials are broken apart, layered, and made strange again.</p>
      <div class="practice-columns">
        <p>The work begins with material curiosity: the weight of a ceramic fragment, light passing through glass, or a surface that records how it was handled.</p>
        <p>Assemblage and experimentation guide each piece. Texture is not an effect added at the end. It is often where the work starts.</p>
      </div>
    </div>
  </section>

  {textureImage && (
    <section class="texture-feature" aria-labelledby="texture-title">
      <div class="texture-heading page-shell">
        <h2 id="texture-title" class="section-label">Surface / detail</h2>
        <p>Material at close range</p>
      </div>
      <ArtworkImage
        src={textureImage.src}
        alt={textureImage.alt}
        fullResolution={textureArtwork.data.fullResolution}
        caption={`${textureArtwork.data.title} · Macro detail`}
        sizes="100vw"
        lightbox
        gallery="texture-feature"
      />
    </section>
  )}

  <section class="featured section page-shell" aria-labelledby="featured-title">
    <div class="featured-intro">
      <h2 id="featured-title" class="section-label">Featured work</h2>
      <p class="eyebrow">Featured artwork</p>
      <h3>{feature.data.title}</h3>
      {feature.data.description && <p class="featured-description">{feature.data.description}</p>}
      <dl>
        <div><dt>Year</dt><dd>{feature.data.year}</dd></div>
        <div><dt>Dimensions</dt><dd>{feature.data.dimensions}</dd></div>
      </dl>
      <a class="text-link" href={`/artwork/${feature.data.slug}/`}>View artwork</a>
    </div>
    <div class="featured-images">
      <ArtworkImage
        src={feature.data.hero.src}
        alt={feature.data.hero.alt}
        fullResolution={feature.data.fullResolution}
        caption={`${feature.data.title} · Full view`}
        sizes="(min-width: 768px) 52vw, 100vw"
        lightbox
        gallery="featured-work"
      />
      {featureDetail && (
        <ArtworkImage
          src={featureDetail.src}
          alt={featureDetail.alt}
          fullResolution={feature.data.fullResolution}
          caption={`${feature.data.title} · Macro detail`}
          sizes="(min-width: 768px) 25vw, 48vw"
          lightbox
          gallery="featured-work"
        />
      )}
      {featureAngle && (
        <ArtworkImage
          src={featureAngle.src}
          alt={featureAngle.alt}
          fullResolution={feature.data.fullResolution}
          caption={`${feature.data.title} · Angled view`}
          sizes="(min-width: 768px) 25vw, 48vw"
          lightbox
          gallery="featured-work"
        />
      )}
    </div>
  </section>

  <section class="commission-teaser section page-shell" aria-labelledby="commission-title">
    <p class="section-label">Commissions</p>
    <div>
      <h2 id="commission-title">Commissions begin with an idea, not a blueprint.</h2>
      <div>
        <span class="draft-note">Draft for artist review</span>
        <p>You establish a meaningful object, memory, subject, palette, or general direction. I carry that starting point through my own material choices and process.</p>
        <a class="text-link" href="/contact/?type=commission">Start a commission</a>
      </div>
    </div>
  </section>

  <section class="about-teaser section page-shell" aria-labelledby="about-title">
    <div class="portrait">
      <ArtworkImage
        src={artistPortrait}
        alt="Illustrated portrait of Chelsea in a pink beret riding an electric scooter past flames"
        sizes="(min-width: 768px) 38vw, 100vw"
      />
      <span>Chelsea, artist</span>
    </div>
    <div>
      <p class="section-label">About</p>
      <h2 id="about-title">An open-ended practice shaped by materials.</h2>
      <p>Creativity has a way of revealing itself when you least expect it.</p>
      <a class="text-link" href="/about/">About the artist</a>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    display: grid;
    grid-template-columns: minmax(18rem, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(2rem, 5vw, 7rem);
    align-items: end;
    min-height: calc(100svh - 8.5rem);
    padding-block: clamp(3rem, 7vw, 7rem) var(--section-space);
  }

  .hero-title {
    position: relative;
    z-index: 1;
    padding-bottom: clamp(1rem, 7vw, 8rem);
  }

  .hero-title h1 {
    width: max-content;
    margin: 0 0 2rem;
    font-size: clamp(4.7rem, 10vw, 11rem);
    letter-spacing: -0.055em;
    line-height: 0.68;
    text-transform: uppercase;
  }

  .hero-title h1 span {
    display: block;
  }

  .hero-title h1 span:last-child {
    margin-left: clamp(2rem, 8vw, 8rem);
    font-size: 0.55em;
    letter-spacing: -0.025em;
    white-space: nowrap;
  }

  .hero-title > p {
    max-width: 26rem;
    margin: 0 0 0 clamp(0rem, 5vw, 6rem);
    color: var(--paper-muted);
  }

  .hero-title > .hero-origin {
    margin-top: 1.5rem;
  }

  .hero-origin .draft-note {
    display: table;
  }

  .hero-image {
    width: fit-content;
    max-width: min(100%, 58rem);
    justify-self: end;
  }

  .hero-image :global(img) {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 72svh;
  }

  .hero-image > p {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.75rem;
    color: var(--paper-muted);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .selected-grid {
    padding-bottom: 0;
  }

  .section-action {
    display: flex;
    justify-content: flex-end;
    padding-top: clamp(4rem, 8vw, 8rem);
  }

  .practice {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 3rem;
    border-top: 1px solid var(--line);
  }

  .practice-copy > .large-copy {
    max-width: 62rem;
  }

  .practice-columns {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(2rem, 5vw, 6rem);
    max-width: 50rem;
    margin: 4rem 0 0 auto;
    color: var(--paper-muted);
  }

  .texture-feature {
    overflow: hidden;
    background: var(--charcoal);
  }

  .texture-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding-block: 2rem;
  }

  .texture-heading .section-label,
  .texture-heading p {
    margin: 0;
  }

  .texture-heading p {
    font-family: var(--serif);
    font-size: clamp(1.6rem, 3vw, 3rem);
  }

  .texture-feature :global(.image-button) {
    max-height: 82svh;
  }

  .texture-feature :global(img) {
    width: 100%;
    max-height: 82svh;
    object-fit: cover;
  }

  .featured {
    display: grid;
    grid-template-columns: minmax(18rem, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(3rem, 7vw, 9rem);
    align-items: start;
  }

  .featured-intro {
    position: sticky;
    top: 2rem;
  }

  .featured-intro h3 {
    margin: 0.35rem 0 1.5rem;
    font-size: clamp(3rem, 6vw, 6rem);
  }

  .featured-description {
    color: var(--paper-muted);
  }

  .featured dl {
    margin: 3rem 0;
    border-top: 1px solid var(--line);
  }

  .featured dl div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--line);
  }

  .featured dt {
    color: var(--paper-muted);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .featured dd {
    margin: 0;
  }

  .featured-images {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--page-pad);
  }

  .featured-images > :global(:first-child) {
    grid-column: 1 / -1;
  }

  .commission-teaser {
    border-block: 1px solid var(--line);
  }

  .commission-teaser > div {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: clamp(3rem, 10vw, 12rem);
    align-items: end;
  }

  .commission-teaser h2 {
    max-width: 70rem;
    margin: 0;
  }

  .commission-teaser > div > div p {
    color: var(--paper-muted);
  }

  .about-teaser {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(18rem, 1.2fr);
    gap: clamp(3rem, 8vw, 10rem);
    align-items: center;
  }

  .portrait {
    max-width: 36rem;
  }

  .portrait span {
    display: block;
    padding-top: 0.5rem;
    color: var(--paper-muted);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .about-teaser h2 {
    margin-bottom: 2rem;
  }

  .about-teaser > div:last-child > p:last-of-type {
    max-width: 40rem;
    color: var(--paper-muted);
  }

  @media (max-width: 47.99rem) {
    .home-hero {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 2rem;
      min-height: 0;
      padding-top: 4rem;
    }

    .hero-title {
      width: 100%;
      padding: 0;
    }

    .hero-title h1 {
      width: auto;
      font-size: clamp(3.8rem, 18.5vw, 6.5rem);
      line-height: 0.72;
    }

    .hero-title h1 span:last-child {
      margin-left: 1rem;
    }

    .hero-title > p {
      margin-left: 0;
    }

    .hero-image {
      width: calc(100% + var(--page-pad) * 2);
      max-width: none;
      margin-left: calc(var(--page-pad) * -1);
    }

    .hero-image :global(img) {
      width: 100%;
      max-height: none;
    }

    .hero-image > p {
      padding-inline: var(--page-pad);
    }

    .practice,
    .featured,
    .commission-teaser > div,
    .about-teaser {
      grid-template-columns: 1fr;
    }

    .practice-columns {
      grid-template-columns: 1fr;
      margin-top: 2rem;
    }

    .texture-heading {
      display: block;
    }

    .texture-heading p {
      margin-top: 1rem;
    }

    .texture-feature :global(.image-button),
    .texture-feature :global(img) {
      min-height: 70svh;
      object-fit: cover;
    }

    .featured-intro {
      position: static;
    }

    .commission-teaser > div {
      gap: 2.5rem;
    }

    .about-teaser .portrait {
      width: calc(100% + var(--page-pad));
      margin-left: calc(var(--page-pad) * -1);
    }
  }
</style>
