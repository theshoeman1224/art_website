---
import { sectionPath, sections } from '../sections';

const pathname = Astro.url.pathname.replace(/\/$/, '');
const links = [
  { href: '/work', label: 'Overview' },
  ...sections.map((section) => ({ href: sectionPath(section.id), label: section.label })),
];
---

<nav class="section-nav page-shell" aria-label="Portfolio sections">
  <ul>
    {links.map((link) => (
      <li>
        <a href={link.href} aria-current={pathname === link.href ? 'page' : undefined}>
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .section-nav {
    padding-bottom: clamp(3rem, 6vw, 6rem);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem clamp(1.25rem, 2.4vw, 2.75rem);
    margin: 0;
    padding: 0.6rem 0 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--paper-muted);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-decoration: none;
    text-transform: uppercase;
  }

  a[aria-current='page'] {
    color: var(--paper);
    box-shadow: inset 0 -1px 0 var(--clay);
  }
</style>
