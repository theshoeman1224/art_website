---
import type { CollectionEntry } from 'astro:content';
import { statusLabels } from '../lib/artworks';
import ArtworkImage from './ArtworkImage.astro';

interface Props {
  artwork: CollectionEntry<'artworks'>;
  eager?: boolean;
  sizes?: string;
  headingLevel?: 'h2' | 'h3';
}

const {
  artwork,
  eager = false,
  sizes = '(min-width: 768px) 50vw, 100vw',
  headingLevel = 'h2',
} = Astro.props;
const { title, slug, year, hero, dimensions, status } = artwork.data;
const Heading = headingLevel;
// An available work, and one with no status, shows its size alone.
const statusLabel = !status || status === 'available' ? undefined : statusLabels[status];
---

<article class="artwork-card">
  <div class="artwork-media">
    <a
      href={`/artwork/${slug}/`}
      class="artwork-image-link artwork-frame"
      aria-label={`View ${title}`}
      style={hero.focusY === undefined ? undefined : `--focus-y: ${hero.focusY}%`}
    >
      <ArtworkImage
        src={hero.src}
        alt={hero.alt}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        fullResolution={artwork.data.fullResolution}
      />
    </a>
    <p class="artwork-overlay" data-artwork-status={status}>
      <span class="artwork-size">{dimensions}</span>
      {statusLabel && <span class="artwork-status">{statusLabel}</span>}
    </p>
  </div>
  <div class="artwork-caption">
    <div>
      <Heading><a href={`/artwork/${slug}/`}>{title}</a></Heading>
      <p>{year}</p>
    </div>
  </div>
</article>

<style>
  .artwork-card {
    margin: 0;
  }

  .artwork-image-link {
    display: block;
    overflow: hidden;
  }

  .artwork-image-link :global(img) {
    width: 100%;
    transition: transform 500ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .artwork-image-link:hover :global(img) {
    transform: scale(1.012);
  }

  .artwork-media {
    position: relative;
  }

  /* Sits over the photograph and lets the pointer through to the link underneath. */
  .artwork-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    padding: 7%;
    color: var(--paper);
    text-align: center;
    background: rgb(11 11 10 / 85%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms ease;
  }

  .artwork-image-link:hover + .artwork-overlay,
  .artwork-image-link:focus-visible + .artwork-overlay {
    opacity: 1;
  }

  .artwork-size {
    font-family: var(--serif);
    font-size: clamp(1.6rem, 2.4vw, 2.3rem);
    letter-spacing: 0;
    line-height: 1;
    text-transform: none;
  }

  .artwork-status {
    letter-spacing: 0.14em;
  }

  .artwork-caption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  h2,
  h3 {
    margin-bottom: 0.25rem;
    font-size: clamp(1.8rem, 3vw, 2.7rem);
    line-height: 1;
  }

  h2 a,
  h3 a {
    text-decoration: none;
  }

  p {
    margin: 0;
    color: var(--paper-muted);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 35rem) {
    .artwork-caption {
      display: block;
    }
  }

  /* Nothing to hover with on a touch screen, so the same line sits under the photograph. */
  @media (hover: none) {
    .artwork-overlay {
      position: static;
      flex-direction: row;
      justify-content: space-between;
      padding: 0.75rem 0;
      color: var(--paper-muted);
      background: none;
      opacity: 1;
    }

    .artwork-size {
      font: inherit;
      letter-spacing: inherit;
      text-transform: inherit;
    }
  }
</style>
