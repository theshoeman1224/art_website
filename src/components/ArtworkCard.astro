---
import type { CollectionEntry } from 'astro:content';
import ArtworkImage from './ArtworkImage.astro';

interface Props {
  artwork: CollectionEntry<'artworks'>;
  eager?: boolean;
  sizes?: string;
  headingLevel?: 'h2' | 'h3';
}

const {
  artwork,
  eager = false,
  sizes = '(min-width: 768px) 50vw, 100vw',
  headingLevel = 'h2',
} = Astro.props;
const { title, slug, year, medium, hero } = artwork.data;
const Heading = headingLevel;
---

<article class="artwork-card">
  <a href={`/artwork/${slug}`} class="artwork-image-link artwork-frame" aria-label={`View ${title}`}>
    <ArtworkImage
      src={hero.src}
      alt={hero.alt}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
    />
  </a>
  <div class="artwork-caption">
    <div>
      <Heading><a href={`/artwork/${slug}`}>{title}</a></Heading>
      <p>{year} · {medium}</p>
    </div>
  </div>
</article>

<style>
  .artwork-card {
    margin: 0;
  }

  .artwork-image-link {
    display: block;
    overflow: hidden;
  }

  .artwork-image-link :global(img) {
    width: 100%;
    transition: transform 500ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .artwork-image-link:hover :global(img) {
    transform: scale(1.012);
  }

  .artwork-caption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  h2,
  h3 {
    margin-bottom: 0.25rem;
    font-size: clamp(1.8rem, 3vw, 2.7rem);
    line-height: 1;
  }

  h2 a,
  h3 a {
    text-decoration: none;
  }

  p {
    margin: 0;
    color: var(--paper-muted);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 35rem) {
    .artwork-caption {
      display: block;
    }
  }
</style>
