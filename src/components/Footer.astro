---
import { siteConfig } from '../config';
---

<footer class="site-footer page-shell">
  <p class="footer-mark">Endeavor<br />Art Studio</p>
  <div>
    <p>Mixed-media art exploring texture, material, and transformation.</p>
    <div class="footer-links">
      <a href={`mailto:${siteConfig.email}`}>Email</a>
      <a href={siteConfig.instagram} rel="me">Instagram</a>
    </div>
  </div>
  <p class="copyright">© {new Date().getFullYear()} Endeavor Art Studio</p>
</footer>

<style>
  .site-footer {
    display: grid;
    grid-template-columns: 1fr 1.5fr 1fr;
    gap: 3rem;
    align-items: end;
    padding-block: clamp(4rem, 8vw, 7rem) 2rem;
    color: var(--paper-muted);
    border-top: 1px solid var(--line);
  }

  .footer-mark {
    margin: 0;
    color: var(--paper);
    font-family: var(--serif);
    font-size: clamp(2.3rem, 4vw, 4rem);
    line-height: 0.78;
    text-transform: uppercase;
  }

  .site-footer > div p {
    max-width: 26rem;
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
  }

  .footer-links a {
    min-height: 2.75rem;
  }

  .copyright {
    margin: 0;
    font-size: 0.75rem;
    text-align: right;
  }

  @media (max-width: 47.99rem) {
    .site-footer {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .copyright {
      text-align: left;
    }
  }
</style>
