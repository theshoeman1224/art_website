---
import emblem from '../assets/endeavor-emblem.png';
import { siteConfig } from '../config';
---

<footer class="site-footer page-shell">
  <div class="footer-identity">
    <img src={emblem.src} alt="" width="112" height="112" />
    <p class="footer-mark">Endeavor<br />Art Studio</p>
  </div>
  <div>
    <p>Mixed-media art exploring texture, material, and transformation.</p>
    <div class="footer-links">
      <a href={`mailto:${siteConfig.email}`}>Email</a>
      <a href={siteConfig.instagram} rel="me">Instagram</a>
    </div>
  </div>
  <p class="copyright">© {new Date().getFullYear()} {siteConfig.legalName}</p>
</footer>

<style>
  .site-footer {
    display: grid;
    grid-template-columns: minmax(30rem, 1fr) minmax(20rem, 1fr) max-content;
    gap: clamp(2rem, 3vw, 3rem);
    align-items: end;
    padding-block: clamp(4rem, 8vw, 7rem) 2rem;
    color: var(--paper-muted);
    border-top: 1px solid var(--line);
  }

  .footer-mark {
    margin: 0;
    color: var(--paper);
    font-family: var(--serif);
    font-size: clamp(2.3rem, 4vw, 4rem);
    line-height: 0.78;
    text-transform: uppercase;
  }

  .footer-identity {
    display: flex;
    gap: clamp(1rem, 2vw, 1.75rem);
    align-items: center;
  }

  .footer-identity img {
    width: clamp(4.5rem, 7vw, 7rem);
    height: auto;
    flex: 0 0 auto;
    background: transparent;
  }

  .site-footer > div p {
    max-width: 26rem;
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
  }

  .footer-links a {
    min-height: 2.75rem;
  }

  .copyright {
    margin: 0;
    font-size: 0.75rem;
    text-align: right;
  }

  @media (max-width: 67.99rem) {
    .site-footer {
      grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
    }

    .copyright {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 47.99rem) {
    .site-footer {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .copyright {
      grid-column: auto;
      text-align: left;
    }
  }
</style>
