---
import emblem from '../assets/endeavor-emblem.png';
import { siteConfig } from '../config';
---

<footer class="site-footer page-shell">
  <div class="footer-identity">
    <img src={emblem.src} alt="" width="112" height="112" />
    <p class="footer-mark">Endeavor<br />Art Studio</p>
  </div>
  <div class="footer-links">
    <a href={`mailto:${siteConfig.email}`}>Email</a>
    <a href={siteConfig.instagram} rel="me">Instagram</a>
  </div>
  <p class="copyright">© {new Date().getFullYear()} {siteConfig.legalName}</p>
</footer>

<style>
  /* Equal outer columns keep the links on the page's center line. */
  .site-footer {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: center;
    padding-block: clamp(2rem, 3vw, 2.5rem);
    color: var(--paper-muted);
    border-top: 1px solid var(--line);
  }

  .footer-identity {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .footer-identity img {
    width: 4rem;
    height: auto;
    flex: 0 0 auto;
    background: transparent;
  }

  .footer-mark {
    margin: 0;
    color: var(--paper);
    font-family: var(--serif);
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    letter-spacing: 0.08em;
    line-height: 0.88;
    text-transform: uppercase;
  }

  .footer-links {
    display: flex;
    gap: clamp(1.5rem, 2.4vw, 2.75rem);
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .copyright {
    margin: 0;
    font-size: 0.75rem;
    text-align: right;
  }

  @media (max-width: 47.99rem) {
    .site-footer {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .copyright {
      text-align: left;
    }
  }
</style>
