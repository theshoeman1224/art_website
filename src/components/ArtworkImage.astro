---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  sizes?: string;
  /**
   * For a slot that fits the photograph inside a CSS `max-height`: the cap in `vh`, the slot's width in `vw` where
   * the cap applies (default 100), and the media condition under which it applies, if not always. On a screen wide
   * enough for the cap to bind, `sizes` then gives the photograph's real width rather than the slot's.
   */
  heightCap?: { vh: number; slot?: number; media?: string };
  loading?: 'eager' | 'lazy';
  /** The page's main image: loads eagerly, decodes synchronously, and is fetched with high priority. */
  priority?: boolean;
  /** Serves the photograph exactly as supplied, with no resizing or re-encoding. Pass the artwork's `fullResolution`. */
  fullResolution?: boolean;
  lightbox?: boolean;
  gallery?: string;
  class?: string;
}

const {
  src,
  alt,
  caption,
  sizes: slotSizes = '100vw',
  heightCap,
  // Left undefined so `priority` can choose it; Astro then defaults to lazy.
  loading,
  priority = false,
  fullResolution = false,
  lightbox = false,
  gallery = 'page',
  class: className,
} = Astro.props;

// <Picture> takes one quality for every format, so the <picture> is built here to let each format have its own. The
// scales differ: AVIF at 88 is larger than WebP at 88, and AVIF at 60 is about a third the size of AVIF at 88.
// The fallback is for browsers with neither AVIF nor WebP, in the source's own format, as <Picture> chose it.
// Works whose deep blacks suffer at these settings use `fullResolution` instead of a higher number here.
const quality = { avif: 60, webp: 80, fallback: 80 };
// The browser picks a srcset width before layout, from `sizes` alone. A height-capped photograph on a wide screen is
// narrower than its slot: it shows `vh × aspect ratio` wide once the screen's aspect ratio exceeds that over the slot
// width. `sizes` cannot use `svh` or read CSS, so this uses `vh`, which is never smaller than `svh` and so errs large.
const sizes = heightCap ? cappedSizes(heightCap) : slotSizes;

function cappedSizes({ vh, slot = 100, media }: NonNullable<Props['heightCap']>) {
  const shown = (vh * src.width) / src.height;
  const condition = [media, `(min-aspect-ratio: ${Math.round((shown / slot) * 1000)}/1000)`].filter(Boolean).join(' and ');
  return `${condition} ${Math.ceil(shown * 10) / 10}vh, ${slotSizes}`;
}
const responsiveWidths = [...new Set([480, 960, Math.min(src.width, 1600)])].sort((a, b) => a - b);

let sources: { type: string; srcset: string }[] = [];
let image: HTMLAttributes<'img'>;
let fullImage: string | undefined;

if (fullResolution) {
  // The original file, which Astro emits under a content hash, is the only source, here and in the lightbox.
  image = {
    src: src.src,
    alt,
    width: src.width,
    height: src.height,
    loading: loading ?? (priority ? 'eager' : 'lazy'),
    decoding: priority ? 'sync' : 'async',
    fetchpriority: priority ? 'high' : undefined,
  };
  fullImage = src.src;
} else {
  const transform = { src, alt, widths: responsiveWidths, sizes, loading, priority };
  const [avif, webp, fallback] = await Promise.all([
    getImage({ ...transform, format: 'avif', quality: quality.avif }),
    getImage({ ...transform, format: 'webp', quality: quality.webp }),
    getImage({ ...transform, format: src.format === 'png' ? 'png' : 'jpg', quality: quality.fallback }),
  ]);
  sources = [
    { type: 'image/avif', srcset: avif.srcSet.attribute },
    { type: 'image/webp', srcset: webp.srcSet.attribute },
  ];
  image = { src: fallback.src, srcset: fallback.srcSet.attribute, ...fallback.attributes };
  fullImage = lightbox
    ? (await getImage({ src, width: Math.min(src.width, 2200), format: 'webp', quality: 92 })).src
    : undefined;
}
---

{
  lightbox ? (
    <button
      class:list={['image-button', className]}
      type="button"
      aria-label={`View larger image: ${alt}`}
      data-lightbox-src={fullImage}
      data-lightbox-alt={alt}
      data-lightbox-caption={caption ?? ''}
      data-lightbox-group={gallery}
    >
      <picture>
        {sources.map((source) => <source srcset={source.srcset} type={source.type} sizes={sizes} />)}
        <img {...image} />
      </picture>
      <span class="expand-label" aria-hidden="true">View larger</span>
    </button>
  ) : (
    <picture>
      {sources.map((source) => <source srcset={source.srcset} type={source.type} sizes={sizes} />)}
      <img {...image} class={className} />
    </picture>
  )
}

<style>
  .image-button {
    position: relative;
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
    color: var(--paper);
    background: transparent;
    border: 0;
    cursor: zoom-in;
  }

  .image-button :global(picture),
  .image-button :global(img) {
    width: 100%;
  }

  .expand-label {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    padding: 0.45rem 0.6rem;
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: rgb(11 11 10 / 78%);
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .image-button:hover .expand-label,
  .image-button:focus-visible .expand-label {
    opacity: 1;
  }

  @media (hover: none) {
    .expand-label {
      opacity: 1;
    }
  }
</style>
