---
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  sizes?: string;
  loading?: 'eager' | 'lazy';
  lightbox?: boolean;
  gallery?: string;
  class?: string;
}

const {
  src,
  alt,
  caption,
  sizes = '100vw',
  loading = 'lazy',
  lightbox = false,
  gallery = 'page',
  class: className,
} = Astro.props;

const responsiveWidths = [...new Set([480, 960, Math.min(src.width, 1600)])].sort((a, b) => a - b);

const fullImage = lightbox
  ? await getImage({ src, width: Math.min(src.width, 2200), format: 'webp', quality: 92 })
  : undefined;
---

{
  lightbox ? (
    <button
      class:list={['image-button', className]}
      type="button"
      aria-label={`View larger image: ${alt}`}
      data-lightbox-src={fullImage?.src}
      data-lightbox-alt={alt}
      data-lightbox-caption={caption ?? ''}
      data-lightbox-group={gallery}
    >
      <Picture
        src={src}
        alt={alt}
        formats={['avif', 'webp']}
        widths={responsiveWidths}
        sizes={sizes}
        loading={loading}
        quality={88}
      />
      <span class="expand-label" aria-hidden="true">View larger</span>
    </button>
  ) : (
    <Picture
      class={className}
      src={src}
      alt={alt}
      formats={['avif', 'webp']}
      widths={responsiveWidths}
      sizes={sizes}
      loading={loading}
      quality={88}
    />
  )
}

<style>
  .image-button {
    position: relative;
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
    color: var(--paper);
    background: transparent;
    border: 0;
    cursor: zoom-in;
  }

  .image-button :global(picture),
  .image-button :global(img) {
    width: 100%;
  }

  .expand-label {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    padding: 0.45rem 0.6rem;
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: rgb(11 11 10 / 78%);
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .image-button:hover .expand-label,
  .image-button:focus-visible .expand-label {
    opacity: 1;
  }

  @media (hover: none) {
    .expand-label {
      opacity: 1;
    }
  }
</style>
