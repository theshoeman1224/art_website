---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSortedArtworks, inSection } from '../lib/artworks';
import { sections, type SectionId } from '../sections';
import ArtworkCard from './ArtworkCard.astro';
import SectionNav from './SectionNav.astro';

interface Props {
  section: SectionId;
}

const section = sections.find((item) => item.id === Astro.props.section)!;
const artworks = inSection(await getSortedArtworks(), section.id);
---

<BaseLayout title={`Work / ${section.label}`} description={section.description}>
  <header class="work-header page-shell">
    <p class="eyebrow">Work / {artworks.length} {artworks.length === 1 ? 'work' : 'works'}</p>
    <h1>{section.label}</h1>
    <div>
      <span class="draft-note">Draft for artist review</span>
      <p>{section.description}</p>
    </div>
  </header>

  <SectionNav />

  {artworks.length > 0 ? (
    <section class="artwork-grid page-shell" aria-label={`${section.label} portfolio`}>
      {artworks.map((artwork) => (
        <ArtworkCard artwork={artwork} sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" />
      ))}
    </section>
  ) : (
    <p class="empty page-shell">No works here yet.</p>
  )}

  {section.cta && (
    <aside class="section-cta page-shell">
      <a class="text-link" href={section.cta.href}>{section.cta.label}</a>
    </aside>
  )}
</BaseLayout>

<style>
  .work-header {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2rem;
    align-items: end;
    padding-block: clamp(5rem, 10vw, 10rem) clamp(3rem, 6vw, 6rem);
  }

  .work-header .eyebrow {
    align-self: start;
  }

  .work-header h1 {
    grid-column: 2;
    margin: 0;
  }

  .work-header > div {
    grid-column: 2;
    max-width: 35rem;
    margin-top: 1rem;
    color: var(--paper-muted);
  }

  .work-header > div p {
    margin: 0;
  }

  .empty {
    padding-bottom: var(--section-space);
    color: var(--paper-muted);
  }

  .section-cta {
    display: flex;
    justify-content: flex-end;
    padding-block: 2rem var(--section-space);
    border-top: 1px solid var(--line);
  }

  @media (max-width: 47.99rem) {
    .work-header {
      grid-template-columns: 1fr;
    }

    .work-header h1,
    .work-header > div {
      grid-column: 1;
    }
  }
</style>
