---
import { Picture } from 'astro:assets';
import emblem from '../assets/endeavor-emblem.png';
import { emblemImage } from '../lib/emblem';

const pathname = Astro.url.pathname;
const nav = [
  { href: '/artwork/', label: 'Artwork' },
  { href: '/about/', label: 'About' },
  { href: '/contact/?type=commission', label: 'Commissions' },
  { href: '/contact/', label: 'Contact' },
];
---

<header class="site-header page-shell">
  <a class="wordmark" href="/" aria-label="Endeavor Art Studio home">
    <Picture src={emblem} alt="" width={52} height={52} {...emblemImage} loading="eager" />
    <span class="wordmark-text">
      <span>Endeavor</span>
      <span>Art Studio</span>
    </span>
  </a>
  <nav aria-label="Main navigation">
    <ul>
      {nav.map((item) => (
        <li>
          <a href={item.href} aria-current={pathname.startsWith(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .wordmark {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    gap: 0.8rem;
    color: var(--paper);
    font-family: var(--serif);
    font-size: 1.2rem;
    letter-spacing: 0.08em;
    line-height: 0.88;
    text-decoration: none;
    text-transform: uppercase;
  }

  .wordmark img {
    width: 3.25rem;
    height: 3.25rem;
    background: transparent;
  }

  .wordmark-text {
    display: flex;
    flex-direction: column;
  }

  nav ul {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.4vw, 2.75rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: block;
    padding-block: 0.35rem;
    color: var(--paper-muted);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-decoration: none;
    text-transform: uppercase;
    /* Every tab carries the underline's 1px, so the current one sits level with the rest. */
    border-bottom: 1px solid transparent;
  }

  nav a[aria-current='page'] {
    color: var(--paper);
    border-bottom-color: var(--clay);
  }

  @media (max-width: 39rem) {
    .site-header {
      display: block;
      padding-block: 1.1rem 0.75rem;
    }

    .wordmark {
      width: max-content;
      margin-bottom: 1rem;
    }

    nav {
      width: 100%;
      max-width: 100%;
      overflow-x: auto;
      scrollbar-width: none;
    }

    nav ul {
      justify-content: space-between;
      gap: 0.75rem;
    }

    nav a {
      min-height: 2.75rem;
      padding-block: 0.8rem;
    }
  }
</style>
